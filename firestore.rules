rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A tanár: Google-fiókkal belépve, ellenőrzött e-mail-címmel.
    // A TANAR_EMAIL_CIME helyére a saját címedet írd (csak a Firebase-konzolban, ne a nyilvános repóba).
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'TANAR_EMAIL_CIME'
        && request.auth.token.email_verified == true;
    }
    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isMe(uid);   // mindenki a saját profilját
      allow read: if isTeacher();        // a tanár mindenkiét olvashatja

      // válaszok naplója: a felhasználó csak hozzáírhat, a tanár olvashatja
      match /answers/{aid} {
        allow create: if isMe(uid);
        allow read: if isMe(uid) || isTeacher();
      }
    }

    // heti ranglista: bejelentkezve mindenki olvashatja, mindenki csak a saját sorát írhatja
    match /board/{uid} {
      allow read: if request.auth != null;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'week', 'pts', 'streak', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.week is string && request.resource.data.week.size() <= 10
        && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts < 100000
        && request.resource.data.streak is int;
    }
  }
}
